// generated by `dotfiles theme` — do not edit, switching themes overwrites it (theme: ayu-dark)
layout {
    tab name="agent" {
      pane
    }

    tab name="nvim" focus=true {
        pane
    }

    tab name="shell" {
        pane
    }

    default_tab_template {
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
                format_left   "{mode} #[fg=#ea6c73,bold]{session}{tabs}"
                format_right  "{command_git_branch} {datetime}"
                format_space  ""

                border_enabled  "false"
                border_char     "─"
                border_format   "#[fg=#1f2430]{char}"
                border_position "top"

                hide_frame_for_single_pane "true"
                mode_normal  "#[bg=#131721] "
                mode_tmux    "#[bg=#ea6c73] "

                tab_normal   "#[fg=#686868] {name} "
                tab_active   "#[fg=#e6b450,bold,italic] {name} "

                command_git_branch_command     "git rev-parse --abbrev-ref HEAD"
                command_git_branch_format      "#[fg=#f9af4f] {stdout} "
                command_git_branch_interval    "10"
                command_git_branch_rendermode  "static"

                datetime        "#[fg=#686868,bold] {format} "
                datetime_format "%A, %d %b %Y %H:%M"
                datetime_timezone "America/Bogota"
            }
        }
        children
        pane size=1 borderless=true  {
            plugin location="zellij:status-bar"
        }
    }
}
