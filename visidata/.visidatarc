# Machine-local theme written by `dotfiles theme` (see internal/theme). Absent
# on a machine that has never switched themes, in which case VisiData keeps its
# own defaults. It has to be a separate file: the theme is per-machine state
# and this rc is committed.
import os as _os

_theme = _os.path.expanduser('~/.visidata/theme.py')
if _os.path.exists(_theme):
    with open(_theme) as _fp:
        exec(compile(_fp.read(), _theme, 'exec'))

# Auto-detect the CSV delimiter, which VisiData does not do on its own:
# its csv loader passes options.csv_delimiter (default ",") straight to csv.reader.
# Scores candidates by field-count consistency across a sample, like csvview.nvim.
import csv as _csv
from visidata import vd, Path

_CANDIDATES = [',', ';', '\t', '|']


def _sample_lines(p, n=20):
    try:
        with p.open_text(newline='') as fp:
            return [line for _, line in zip(range(n), fp)]
    except Exception:
        return []


def _score(lines, delim):
    try:
        rows = [r for r in _csv.reader(lines, delimiter=delim) if r]
    except Exception:
        return 0
    if not rows:
        return 0
    counts = [len(r) for r in rows]
    nfields = max(set(counts), key=counts.count)
    if nfields < 2:
        return 0
    # consistency * field count, so ";" beats "," on a 5-field semicolon file
    return (counts.count(nfields) / len(counts)) * nfields


def sniff_csv_delimiter(p):
    lines = _sample_lines(p)
    if not lines:
        return None
    best = max(_CANDIDATES, key=lambda d: _score(lines, d))
    return best if _score(lines, best) > 0 else None


_orig_open_csv = vd.open_csv


def open_csv(p, *args, **kwargs):
    sheet = _orig_open_csv(p, *args, **kwargs)
    # Respect an explicit --csv-delimiter; only guess when it's still the default.
    if vd.options.csv_delimiter == vd.options.getdefault('csv_delimiter'):
        d = sniff_csv_delimiter(p)
        if d and d != ',':
            # CsvSheet.iterload reads self.source.options, not the sheet's,
            # so the override has to land on the Path.
            p.options.csv_delimiter = d
            vd.status(f'detected delimiter: {d!r}')
    return sheet


vd.open_csv = open_csv


# Expand JSON *text* columns with `(`.
#
# VisiData's expand-col dispatches on the cell value's type (features/
# expand_cols.py registers dict and list), so a column holding JSON as a string
# -- exactly what a CSV or a psql result gives you -- does nothing when you
# press `(`. Parse those cells into real objects first, then hand off to the
# built-in expander. Columns that already hold containers are untouched, so this
# only ever adds behaviour.
import json as _json

from visidata import Column, Sheet


def _looks_like_json(v):
    return isinstance(v, str) and v.lstrip()[:1] in ('{', '[')


@Sheet.api
def expand_col_or_json(sheet, col):
    sample = []
    for r in sheet.rows[:20]:
        try:
            sample.append(col.getValue(r))
        except Exception:
            pass

    if any(_looks_like_json(v) for v in sample):
        def _getter(c, r, _col=col):
            v = _col.getValue(r)
            if isinstance(v, str):
                try:
                    return _json.loads(v)
                except Exception:
                    return None
            return v

        parsed = Column(col.name + '_json', getter=_getter)
        sheet.addColumn(parsed, index=sheet.columns.index(col) + 1)
        col.hide()
        col = parsed

    sheet.expand_cols_deep([col], depth=1)


Sheet.addCommand('(', 'expand-col', 'expand_col_or_json(cursorCol)',
                 'expand current column of containers one level, parsing JSON text first')


# Copy the current column to the system clipboard as a *single delimited line*.
#
# The built-in `gzY` (syscopy-cells) round-trips the column through a saver, so
# it lands in the clipboard one value per line -- the wrong shape for a SQL
# `IN (...)`, a config list, or a chat message. It also hard-fails with "no rows
# selected" when nothing is selected. These take the selected rows, or the whole
# column when the selection is empty, and pipe the joined text straight to
# options.clipboard_copy_cmd.
from visidata import TableSheet


@TableSheet.api
def syscopy_col_joined(sheet, sep=None, quote=''):
    rows = sheet.selectedRows or sheet.rows
    if not rows:
        vd.warning('no rows to copy')
        return

    col = sheet.cursorCol
    vals = [col.getDisplayValue(r) for r in rows]

    if sep is None:
        sep = vd.input('join %d %s with: ' % (len(vals), col.name), value=', ')

    if quote:
        # double the quote char inside the value, SQL/CSV style
        vals = [quote + v.replace(quote, quote * 2) + quote for v in vals]

    sheet.syscopyValue(sep.join(vals))
    vd.status('copied %d %s to system clipboard' % (len(vals), col.name))


TableSheet.addCommand('gzL', 'syscopy-col-joined', 'syscopy_col_joined()',
                      'copy current column (selected rows, or all) to system clipboard joined by an input separator')
TableSheet.addCommand('gzQ', 'syscopy-col-sqllist', 'syscopy_col_joined(sep=", ", quote="\'")',
                      "copy current column to system clipboard as a quoted, comma-separated SQL IN-list")


# --- JSON viewing -----------------------------------------------------------
#
# A JSON blob in a psql/CSV result is a wall of unreadable text in a 30-column
# cell. `(` above turns it into columns; these three make it readable *in place*.

from visidata import BaseSheet, PyobjSheet, TextSheet


def _parse_json_cell(v):
    'Return the object for a JSON-ish cell value, or None if it is not one.'
    if isinstance(v, (dict, list)):
        return v
    if _looks_like_json(v):
        try:
            return _json.loads(v)
        except Exception:
            return None
    return None


def _cell_overflows(col, text):
    'True when the cell display is clipped by its column width, so the sidebar is worth it.'
    if not text:
        return False
    if '\n' in text:
        return True
    w = col.width or 0
    return w > 0 and len(text) > w - 1


@BaseSheet.cached_property
def default_sidebar(sheet):
    '''Show the current cell in the sidebar: pretty-printed when it holds JSON,
    in full when it is too long (or too multi-line) to fit its column. Falls back
    to the stock sidebar otherwise.'''
    try:
        col, row = sheet.cursorCol, sheet.cursorRow
        obj = _parse_json_cell(col.getValue(row))
        if obj is not None:
            body = _json.dumps(obj, indent=2, ensure_ascii=False, default=str)
            return f'# json: {col.name}\n{body}'

        text = col.getDisplayValue(row)
        if _cell_overflows(col, text):
            return f'# {col.name}\n{text}'
    except Exception:
        pass

    # stock behaviour: format options.disp_sidebar_fmt
    fmt = sheet.options.disp_sidebar_fmt
    if not fmt:
        return ''
    return sheet.formatString(fmt, help=sheet.formatter_helpstr)


@Sheet.api
def open_json_cell(sheet):
    'Push the current cell parsed as JSON, to drill into nested structures.'
    obj = _parse_json_cell(sheet.cursorCol.getValue(sheet.cursorRow))
    if obj is None:
        vd.warning('cell is not JSON')
        return
    vd.push(PyobjSheet(f'{sheet.name}_{sheet.cursorCol.name}', source=obj))


Sheet.addCommand('z(', 'open-cell-json', 'open_json_cell()',
                 'open current cell parsed as JSON as a new sheet')


@Sheet.api
def open_cell_text(sheet):
    'Push the current cell as a wrapped text sheet: the whole value, however long.'
    col, row = sheet.cursorCol, sheet.cursorRow
    obj = _parse_json_cell(col.getValue(row))
    if obj is not None:
        text = _json.dumps(obj, indent=2, ensure_ascii=False, default=str)
    else:
        text = col.getDisplayValue(row)
    if not text:
        vd.warning('cell is empty')
        return
    vs = TextSheet(f'{sheet.name}_{col.name}', source=text.splitlines())
    vs.options.wrap = True  # long single-line values are the whole point
    vd.push(vs)


Sheet.addCommand('zV', 'view-cell', 'open_cell_text()',
                 'open current cell as a full, word-wrapped text sheet')

# readable output from `Ctrl+S foo.json`, instead of one giant line
vd.options.json_indent = 2
